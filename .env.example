# Arcade Vault — variables de entorno
# Copia este archivo a .env.local y rellena los valores reales.
# .env.local está gitignored: NUNCA se versiona.

# API key de Resend (https://resend.com/api-keys) — solo se lee en el servidor.
RESEND_API_KEY=

# Destino de los mensajes del formulario de contacto (ej. ismaelbr87@gmail.com).
CONTACT_TO_EMAIL=

# Remitente. Con dominio de pruebas de Resend usa: onboarding@resend.dev
CONTACT_FROM_EMAIL=

# Supabase — password de la base de datos (solo CLI/MCP, no runtime de la app).
SUPABASE_DB_PASSWORD=

# Supabase Auth — claves públicas (expuestas al browser por diseño; la seguridad real es RLS).
# Obtén los valores con el MCP de Supabase: get_project_url y get_publishable_keys.
NEXT_PUBLIC_SUPABASE_URL=

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
